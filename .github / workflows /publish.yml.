name: Quran Auto Publisher

on:
  schedule:
    - cron: '0 9 * * *'
  workflow_dispatch: 

jobs:
  run-publisher:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.10'

      - name: Install dependencies
        run: |
          pip install supabase requests tiktok-uploader
          playwright install # تثبيت المتصفح المخفي المطلوب للرفع

      - name: Run script
        env:
          SUPABASE_URL: ${{ secrets.SUPABASE_URL }}
          SUPABASE_KEY: ${{ secrets.SUPABASE_KEY }}
          TIKTOK_SESSION_ID: ${{ secrets.TIKTOK_SESSION_ID }}
        run: |
          python main.py
